// Magic sparkles (2D): glowing motes swirling in a vortex around the entity,
// pulsing in size as they live. Units are pixels, for a default 2D camera.
(
  version: 1,
  name: "Magic Sparkles",
  dimension: TwoD,
  duration: 2.0,
  looping: true,
  emitters: [
    (
      name: "sparkles",
      capacity: 300,
      space: Local,
      seed: 29,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (600.0, 0.0), input_values: {
            "spawn_rate": Float(70.0),
            "gravity": Vec3((0.0, 25.0, 0.0)),
            "drag": Float(0.8),
          }),
          (id: 2, node_type: "shape/circle", position: (0.0, 0.0), input_values: {
            "radius": Float(70.0),
          }),
          (id: 3, node_type: "random/range", position: (0.0, 140.0), input_values: {
            "min": Float(10.0), "max": Float(40.0),
          }),
          (id: 4, node_type: "math/multiply", position: (300.0, 60.0)),
          (id: 5, node_type: "random/range", position: (0.0, 280.0), input_values: {
            "min": Float(0.8), "max": Float(1.6), "salt": Float(1.0),
          }),
          (id: 6, node_type: "random/range", position: (0.0, 400.0), input_values: {
            "min": Float(5.0), "max": Float(12.0), "salt": Float(2.0),
          }),
          (id: 7, node_type: "random/color_between", position: (0.0, 520.0), input_values: {
            "a": Color((0.65, 0.4, 1.0, 1.0)),
            "b": Color((0.3, 0.9, 1.0, 1.0)),
          }),
          (id: 8, node_type: "force/vortex", position: (300.0, 280.0), input_values: {
            "axis": Vec3((0.0, 0.0, 1.0)),
            "strength": Float(2.5),
          }),
          (id: 9, node_type: "input/age", position: (0.0, 660.0)),
          (id: 10, node_type: "math/multiply", position: (150.0, 660.0), input_values: {
            "b": Float(14.0),
          }),
          (id: 11, node_type: "math/sin", position: (300.0, 660.0)),
          (id: 12, node_type: "math/remap", position: (450.0, 660.0), input_values: {
            "in_min": Float(-1.0), "in_max": Float(1.0),
            "out_min": Float(0.4), "out_max": Float(1.0),
          }),
          (id: 13, node_type: "curve/curve", position: (450.0, 800.0), input_values: {
            "points": Curve([
              (t: 0.0, value: 0.0, ease: Smooth),
              (t: 0.2, value: 1.0),
              (t: 0.7, value: 1.0, ease: Smooth),
              (t: 1.0, value: 0.0),
            ]),
          }),
          (id: 14, node_type: "math/multiply", position: (600.0, 720.0)),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 1, to_pin: "position"),
          (from_node: 2, from_pin: "direction", to_node: 4, to_pin: "a"),
          (from_node: 3, from_pin: "value", to_node: 4, to_pin: "b"),
          (from_node: 4, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 5, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 6, from_pin: "value", to_node: 1, to_pin: "size"),
          (from_node: 7, from_pin: "color", to_node: 1, to_pin: "color"),
          (from_node: 8, from_pin: "force", to_node: 1, to_pin: "acceleration"),
          (from_node: 9, from_pin: "value", to_node: 10, to_pin: "a"),
          (from_node: 10, from_pin: "value", to_node: 11, to_pin: "value"),
          (from_node: 11, from_pin: "value", to_node: 12, to_pin: "value"),
          (from_node: 12, from_pin: "value", to_node: 14, to_pin: "a"),
          (from_node: 13, from_pin: "value", to_node: 14, to_pin: "b"),
          (from_node: 14, from_pin: "value", to_node: 1, to_pin: "size_over_life"),
        ],
      ),
      render: (
        blend: Additive,
        z_order: 2.0,
      ),
    ),
  ],
)
