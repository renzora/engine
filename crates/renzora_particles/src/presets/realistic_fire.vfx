// Realistic Fire: a ~0.8 m log fire in five layers, after Niagara practice
// (layered emitters, procedural flame tongues through a blackbody ramp, curl
// noise, wind as a force scaled per layer).
//
// Scale. The fire sits on the entity's origin: a bed of logs 0.8 m wide (X) and
// 0.3 m deep (Z) whose tops are about 0.15 m up. In the reference the tongues
// lick 0.5 to 0.8 m above the logs, so every rise below is tuned to land there.
//
// Motion. Every layer drags through the air with `force/wind` instead of the
// output's `drag`: with no wind it is ordinary drag, so a flame's rise settles
// at buoyancy / coupling, and with wind each layer is pulled toward the wind by
// its own coupling. Smoke (1.4) rides the wind, embers (0.8) drift on it,
// flames (0.5 core, 0.6 outer) lean, and the coals (0.1) barely stir. The
// flames' height falloff keeps the base anchored in the shelter of the logs
// while the tips are blown, which is how a real fire bends.
//
// Colour. Flame particles carry an HDR tint in rgb and their heat in alpha;
// the shader maps heat through a blackbody ramp, so the core layer (heat up to
// 1) burns white-yellow and blooms while the outer layer (heat up to 0.8) is
// the orange body, and both cool to red at their eroded edges and tips.
//
// Duration 0: emission never ends and `emitter_time` never wraps, so the curl
// noise scrolls on without the jump a loop boundary would put into it.
(
  version: 1,
  name: "Realistic Fire",
  dimension: ThreeD,
  duration: 0.0,
  looping: true,
  emitters: [
    // (a) Flame core: a few large, very hot tongues from the middle of the
    // logs. Short lives (0.55 to 0.85 s) so they flicker; launched at 0.3 to
    // 0.6 m/s and buoyed at 0.7 m/s^2 against a drag of 0.5/s (terminal rise
    // 1.4 m/s), which carries a tongue's centre 0.35 to 0.65 m up before it
    // erodes away, its tip some 0.2 m higher: the reference's 0.6 to 0.8 m of
    // flame above 0.15 m logs. Curl noise is kept weak (0.6): the curl's
    // magnitude is of order 1 whatever its frequency, so at twice this an
    // updraft outpulls the buoyancy and a tongue shoots a metre up.
    // Velocity-aligned and stretched 0.14 s, so a tongue grows taller as it
    // speeds up: 0.26 m at birth, 0.37 m at full speed. The teardrop in the
    // shader narrows to the tip and the size curve shrinks the tongue as it dies.
    (
      name: "flame core",
      capacity: 48,
      space: Local,
      seed: 101,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (900.0, 0.0), input_values: {
            "spawn_rate": Float(22.0),
            "gravity": Vec3((0.0, 0.7, 0.0)),
            "color": Color((2.2, 2.0, 1.8, 1.0)),
          }),
          (id: 2, node_type: "shape/box", position: (0.0, 0.0), input_values: {
            "size": Vec3((0.42, 0.04, 0.16)),
          }),
          (id: 3, node_type: "math/add", position: (300.0, 0.0), input_values: {
            "b": Vec3((0.0, 0.14, 0.0)),
          }),
          (id: 4, node_type: "random/vec3_range", position: (0.0, 160.0), input_values: {
            "min": Vec3((-0.08, 0.3, -0.05)),
            "max": Vec3((0.08, 0.6, 0.05)),
          }),
          (id: 5, node_type: "random/range", position: (0.0, 320.0), input_values: {
            "min": Float(0.55), "max": Float(0.85), "salt": Float(1.0),
          }),
          (id: 6, node_type: "random/range", position: (0.0, 440.0), input_values: {
            "min": Float(0.17), "max": Float(0.24), "salt": Float(2.0),
          }),
          (id: 7, node_type: "curve/curve", position: (300.0, 440.0), input_values: {
            "points": Curve([
              (t: 0.0, value: 0.55, ease: EaseOut),
              (t: 0.18, value: 1.0),
              (t: 0.7, value: 0.9),
              (t: 1.0, value: 0.6),
            ]),
          }),
          (id: 8, node_type: "curve/gradient", position: (300.0, 580.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 1.0, 1.0, 0.55)),
              (t: 0.08, color: (1.0, 1.0, 1.0, 1.05)),
              (t: 0.45, color: (1.0, 0.97, 0.93, 0.95)),
              (t: 0.8, color: (1.0, 0.9, 0.8, 0.6)),
              (t: 1.0, color: (1.0, 0.85, 0.7, 0.0)),
            ]),
          }),
          (id: 9, node_type: "force/curl_noise", position: (300.0, 720.0), input_values: {
            "strength": Float(0.6),
            "frequency": Float(2.2),
            "scroll": Vec3((0.0, -1.6, 0.0)),
          }),
          (id: 10, node_type: "force/wind", position: (300.0, 880.0), input_values: {
            "coupling": Float(0.5),
            "height_falloff": Float(0.5),
          }),
          (id: 11, node_type: "math/add", position: (600.0, 800.0)),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 3, to_pin: "a"),
          (from_node: 3, from_pin: "value", to_node: 1, to_pin: "position"),
          (from_node: 4, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 5, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 6, from_pin: "value", to_node: 1, to_pin: "size"),
          (from_node: 7, from_pin: "value", to_node: 1, to_pin: "size_over_life"),
          (from_node: 8, from_pin: "color", to_node: 1, to_pin: "color_over_life"),
          (from_node: 9, from_pin: "force", to_node: 11, to_pin: "a"),
          (from_node: 10, from_pin: "force", to_node: 11, to_pin: "b"),
          (from_node: 11, from_pin: "value", to_node: 1, to_pin: "acceleration"),
        ],
      ),
      render: (
        blend: Additive,
        facing: VelocityAligned,
        shading: ProceduralFlame,
        stretch: 0.14,
        soft_distance: 0.06,
      ),
    ),
    // (b) Outer flames: more of them (55/s), across the whole bed, dimmer and
    // cooler (tint 1.45, heat up to 0.8, so orange rather than white) and
