// Smoke: slow, alpha-blended puffs that grow, turn and fade as they drift up.
(
  version: 1,
  name: "Smoke",
  dimension: ThreeD,
  duration: 4.0,
  looping: true,
  emitters: [
    (
      name: "smoke",
      capacity: 160,
      space: World,
      seed: 3,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (600.0, 0.0), input_values: {
            "spawn_rate": Float(10.0),
            "drag": Float(0.4),
          }),
          (id: 2, node_type: "shape/sphere", position: (0.0, 0.0), input_values: {
            "radius": Float(0.3),
          }),
          (id: 3, node_type: "random/vec3_range", position: (0.0, 140.0), input_values: {
            "min": Vec3((-0.15, 0.6, -0.15)),
            "max": Vec3((0.15, 1.1, 0.15)),
          }),
          (id: 4, node_type: "random/range", position: (0.0, 280.0), input_values: {
            "min": Float(3.0), "max": Float(5.0),
          }),
          (id: 5, node_type: "random/range", position: (0.0, 400.0), input_values: {
            "min": Float(0.5), "max": Float(0.8), "salt": Float(1.0),
          }),
          (id: 6, node_type: "random/range", position: (0.0, 520.0), input_values: {
            "min": Float(0.0), "max": Float(6.283), "salt": Float(2.0),
          }),
          (id: 7, node_type: "random/range", position: (0.0, 640.0), input_values: {
            "min": Float(-0.4), "max": Float(0.4), "salt": Float(3.0),
          }),
          (id: 8, node_type: "random/color_between", position: (0.0, 760.0), input_values: {
            "a": Color((0.32, 0.32, 0.34, 0.55)),
            "b": Color((0.5, 0.5, 0.52, 0.55)),
          }),
          (id: 9, node_type: "force/curl_noise", position: (300.0, 400.0), input_values: {
            "strength": Float(0.6),
            "frequency": Float(0.5),
            "scroll": Vec3((0.0, -0.3, 0.0)),
          }),
          (id: 10, node_type: "curve/curve", position: (300.0, 560.0), input_values: {
            "points": Curve([
              (t: 0.0, value: 0.5, ease: EaseOut),
              (t: 1.0, value: 2.6),
            ]),
          }),
          (id: 11, node_type: "curve/gradient", position: (300.0, 700.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 1.0, 1.0, 0.0)),
              (t: 0.2, color: (1.0, 1.0, 1.0, 1.0)),
              (t: 1.0, color: (1.0, 1.0, 1.0, 0.0)),
            ]),
          }),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 1, to_pin: "position"),
          (from_node: 3, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 4, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 5, from_pin: "value", to_node: 1, to_pin: "size"),
          (from_node: 6, from_pin: "value", to_node: 1, to_pin: "rotation"),
          (from_node: 7, from_pin: "value", to_node: 1, to_pin: "angular_velocity"),
          (from_node: 8, from_pin: "color", to_node: 1, to_pin: "color"),
          (from_node: 9, from_pin: "force", to_node: 1, to_pin: "acceleration"),
          (from_node: 10, from_pin: "value", to_node: 1, to_pin: "size_over_life"),
          (from_node: 11, from_pin: "color", to_node: 1, to_pin: "color_over_life"),
        ],
      ),
      render: (
        blend: Alpha,
      ),
    ),
  ],
)
