// Campfire: additive flames rising from a disc, lighting the ground around
// them, plus world-space embers that fall back and bounce off it.
(
  version: 1,
  name: "Campfire",
  dimension: ThreeD,
  duration: 2.0,
  looping: true,
  emitters: [
    (
      name: "flames",
      capacity: 400,
      space: Local,
      seed: 11,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (600.0, 0.0), input_values: {
            "spawn_rate": Float(70.0),
            "gravity": Vec3((0.0, 1.2, 0.0)),
            "drag": Float(1.5),
          }),
          (id: 2, node_type: "shape/cone", position: (0.0, 0.0), input_values: {
            "angle": Float(12.0),
            "radius": Float(0.28),
          }),
          (id: 3, node_type: "random/range", position: (0.0, 160.0), input_values: {
            "min": Float(0.6), "max": Float(1.1),
          }),
          (id: 4, node_type: "random/range", position: (0.0, 280.0), input_values: {
            "min": Float(0.7), "max": Float(1.6), "salt": Float(1.0),
          }),
          (id: 5, node_type: "math/multiply", position: (300.0, 60.0)),
          (id: 6, node_type: "random/range", position: (0.0, 400.0), input_values: {
            "min": Float(0.3), "max": Float(0.5), "salt": Float(2.0),
          }),
          (id: 7, node_type: "random/range", position: (0.0, 520.0), input_values: {
            "min": Float(-1.5), "max": Float(1.5), "salt": Float(3.0),
          }),
          (id: 8, node_type: "math/color", position: (0.0, 640.0), input_values: {
            "value": Color((1.0, 0.55, 0.18, 1.0)),
          }),
          (id: 9, node_type: "force/curl_noise", position: (300.0, 400.0), input_values: {
            "strength": Float(1.6),
            "frequency": Float(1.3),
            "scroll": Vec3((0.0, -1.0, 0.0)),
          }),
          (id: 10, node_type: "curve/curve", position: (300.0, 560.0), input_values: {
            "points": Curve([
              (t: 0.0, value: 0.5, ease: EaseOut),
              (t: 0.25, value: 1.0),
              (t: 1.0, value: 0.1),
            ]),
          }),
          (id: 11, node_type: "curve/gradient", position: (300.0, 700.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 0.9, 0.6, 0.0)),
              (t: 0.12, color: (1.0, 0.85, 0.5, 1.0)),
              (t: 0.55, color: (1.0, 0.4, 0.12, 0.8)),
              (t: 1.0, color: (0.4, 0.06, 0.02, 0.0)),
            ]),
          }),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 1, to_pin: "position"),
          (from_node: 2, from_pin: "direction", to_node: 5, to_pin: "a"),
          (from_node: 4, from_pin: "value", to_node: 5, to_pin: "b"),
          (from_node: 5, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 3, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 6, from_pin: "value", to_node: 1, to_pin: "size"),
          (from_node: 7, from_pin: "value", to_node: 1, to_pin: "angular_velocity"),
          (from_node: 8, from_pin: "value", to_node: 1, to_pin: "color"),
          (from_node: 9, from_pin: "force", to_node: 1, to_pin: "acceleration"),
          (from_node: 10, from_pin: "value", to_node: 1, to_pin: "size_over_life"),
          (from_node: 11, from_pin: "color", to_node: 1, to_pin: "color_over_life"),
        ],
      ),
      render: (
        blend: Additive,
        facing: CameraBillboard,
      ),
      // A warm, flickering light at flame height that follows the flames:
      // about 60 alive at a light weight near 0.27 each, so 7500 lm a flame
      // is about 120000 lm in full flow.
      light: (
        mode: PerEmitter,
        color: (1.0, 0.55, 0.22),
        intensity: 7500.0,
        range: 9.0,
        radius: 0.2,
        smoothing: 0.15,
        flicker: 0.4,
        flicker_rate: 5.0,
        offset: (0.0, 0.4, 0.0),
      ),
    ),
    (
      name: "embers",
      capacity: 128,
      space: World,
      seed: 23,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (600.0, 0.0), input_values: {
            "spawn_rate": Float(9.0),
            "size": Vec2((0.035, 0.035)),
            "gravity": Vec3((0.0, -1.2, 0.0)),
            "drag": Float(0.6),
            "color": Color((1.0, 0.6, 0.2, 1.0)),
          }),
          // Embers arc back down and skip off the ground at the fire's base.
          (id: 7, node_type: "collide/plane", position: (300.0, 640.0), input_values: {
            "bounce": Float(0.35),
            "friction": Float(0.6),
          }),
          (id: 2, node_type: "shape/sphere", position: (0.0, 0.0), input_values: {
            "radius": Float(0.3),
          }),
          (id: 3, node_type: "random/vec3_range", position: (0.0, 160.0), input_values: {
            "min": Vec3((-0.4, 1.4, -0.4)),
            "max": Vec3((0.4, 3.0, 0.4)),
          }),
          (id: 4, node_type: "random/range", position: (0.0, 320.0), input_values: {
            "min": Float(1.4), "max": Float(2.6),
          }),
          (id: 5, node_type: "force/curl_noise", position: (300.0, 320.0), input_values: {
            "strength": Float(3.0),
            "frequency": Float(0.8),
          }),
          (id: 6, node_type: "curve/gradient", position: (300.0, 480.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 1.0, 1.0, 1.0)),
              (t: 0.7, color: (1.0, 0.7, 0.4, 1.0)),
              (t: 1.0, color: (1.0, 0.3, 0.1, 0.0)),
            ]),
          }),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 1, to_pin: "position"),
          (from_node: 3, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 4, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 5, from_pin: "force", to_node: 1, to_pin: "acceleration"),
          (from_node: 6, from_pin: "color", to_node: 1, to_pin: "color_over_life"),
        ],
      ),
      render: (
        blend: Additive,
      ),
    ),
  ],
)
