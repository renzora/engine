// Confetti (2D): a burst every three seconds of spinning paper that tumbles
// down. Units are pixels, for a default 2D camera.
(
  version: 1,
  name: "Confetti",
  dimension: TwoD,
  duration: 3.0,
  looping: true,
  emitters: [
    (
      name: "confetti",
      capacity: 600,
      space: World,
      seed: 17,
      graph: (
        nodes: [
          (id: 1, node_type: "output/particle", position: (600.0, 0.0), input_values: {
            "spawn_rate": Float(0.0),
            "burst_count": Float(160.0),
            "burst_interval": Float(3.0),
            "burst_cycles": Float(0.0),
            "size": Vec2((9.0, 14.0)),
            "gravity": Vec3((0.0, -650.0, 0.0)),
            "drag": Float(1.4),
          }),
          (id: 2, node_type: "shape/rect", position: (0.0, 0.0), input_values: {
            "size": Vec2((60.0, 10.0)),
          }),
          (id: 3, node_type: "random/vec3_range", position: (0.0, 140.0), input_values: {
            "min": Vec3((-280.0, 300.0, 0.0)),
            "max": Vec3((280.0, 650.0, 0.0)),
          }),
          (id: 4, node_type: "random/range", position: (0.0, 280.0), input_values: {
            "min": Float(2.0), "max": Float(3.0),
          }),
          (id: 5, node_type: "random/range", position: (0.0, 400.0), input_values: {
            "min": Float(0.0), "max": Float(6.283), "salt": Float(1.0),
          }),
          (id: 6, node_type: "random/range", position: (0.0, 520.0), input_values: {
            "min": Float(-12.0), "max": Float(12.0), "salt": Float(2.0),
          }),
          (id: 7, node_type: "input/particle_random", position: (0.0, 640.0), input_values: {
            "salt": Float(7.0),
          }),
          (id: 8, node_type: "curve/gradient", position: (300.0, 640.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 0.25, 0.3, 1.0)),
              (t: 0.25, color: (1.0, 0.85, 0.2, 1.0)),
              (t: 0.5, color: (0.3, 0.9, 0.4, 1.0)),
              (t: 0.75, color: (0.25, 0.55, 1.0, 1.0)),
              (t: 1.0, color: (0.9, 0.4, 1.0, 1.0)),
            ]),
          }),
          (id: 9, node_type: "curve/gradient", position: (300.0, 780.0), input_values: {
            "stops": Gradient([
              (t: 0.0, color: (1.0, 1.0, 1.0, 1.0)),
              (t: 0.8, color: (1.0, 1.0, 1.0, 1.0)),
              (t: 1.0, color: (1.0, 1.0, 1.0, 0.0)),
            ]),
          }),
        ],
        connections: [
          (from_node: 2, from_pin: "position", to_node: 1, to_pin: "position"),
          (from_node: 3, from_pin: "value", to_node: 1, to_pin: "velocity"),
          (from_node: 4, from_pin: "value", to_node: 1, to_pin: "lifetime"),
          (from_node: 5, from_pin: "value", to_node: 1, to_pin: "rotation"),
          (from_node: 6, from_pin: "value", to_node: 1, to_pin: "angular_velocity"),
          (from_node: 7, from_pin: "value", to_node: 8, to_pin: "t"),
          (from_node: 8, from_pin: "color", to_node: 1, to_pin: "color"),
          (from_node: 9, from_pin: "color", to_node: 1, to_pin: "color_over_life"),
        ],
      ),
      render: (
        blend: Alpha,
        z_order: 1.0,
      ),
    ),
  ],
)
