  "compiled": {
    "wgsl": "import bevy_pbr::render::pbr_fragment::pbr_input_from_standard_material;\nimport bevy_pbr::render::pbr_functions;\n@if(MESHLET_MESH_MATERIAL_PASS) import bevy_pbr::meshlet::visibility_buffer_resolve::{VertexOutput, resolve_vertex_output};\n@if(PREPASS_PIPELINE && !MESHLET_MESH_MATERIAL_PASS) import bevy_pbr::prepass::io::VertexOutput;\n@if(PREPASS_PIPELINE) import bevy_pbr::prepass::io::FragmentOutput;\n@if(PREPASS_PIPELINE) import bevy_pbr::deferred::functions::deferred_output;\n@if(PREPASS_PIPELINE) import bevy_render::globals::Globals;\n@if(!PREPASS_PIPELINE && !MESHLET_MESH_MATERIAL_PASS) import bevy_pbr::render::forward_io::VertexOutput;\n@if(!PREPASS_PIPELINE) import bevy_pbr::render::forward_io::FragmentOutput;\n@if(!PREPASS_PIPELINE) import bevy_pbr::render::mesh_view_bindings::globals;\nimport bevy_pbr::render::mesh_view_bindings::view;\nimport bevy_pbr::render::mesh_functions;\n@if(PREPASS_PIPELINE) @group(0) @binding(1) var<uniform> globals: Globals;\n\n@group(3) @binding(101) var texture_sampler: sampler;\n@group(3) @binding(100) var texture_0: texture_2d<f32>;\n@group(3) @binding(102) var texture_1: texture_2d<f32>;\n@group(3) @binding(104) var texture_2: texture_2d<f32>;\n@group(3) @binding(106) var texture_3: texture_2d<f32>;\n@group(3) @binding(114) var texture_4: texture_2d<f32>;\n@group(3) @binding(116) var texture_5: texture_2d<f32>;\n@group(3) @binding(124) var texture_6: texture_2d<f32>;\n@group(3) @binding(125) var texture_7: texture_2d<f32>;\n@group(3) @binding(126) var texture_8: texture_2d<f32>;\n@group(3) @binding(127) var texture_9: texture_2d<f32>;\n@group(3) @binding(128) var texture_10: texture_2d<f32>;\n@group(3) @binding(129) var texture_11: texture_2d<f32>;\n@group(3) @binding(130) var texture_12: texture_2d<f32>;\n@group(3) @binding(131) var texture_13: texture_2d<f32>;\n@group(3) @binding(132) var texture_14: texture_2d<f32>;\nstruct LandscapeParams { bounds: vec4<f32>, info: vec4<f32>, channels_a: vec4<u32>, channels_b: vec4<u32>, }\n@group(3) @binding(122) var<uniform> landscape: LandscapeParams;\n@group(3) @binding(123) var landscape_weights: texture_2d_array<f32>;\nstruct SurfaceGraphParams { slots: array<vec4<f32>, 32>, }\n@group(3) @binding(118) var<uniform> material_params: SurfaceGraphParams;\n\nfn mat_hash(p: vec2<f32>) -> f32 {\n    let h = dot(p, vec2<f32>(127.1, 311.7));\n    return fract(sin(h) * 43758.5453123);\n}\n\n// Random gradient for Perlin-style noise\nfn mat_hash_grad(p: vec2<f32>) -> vec2<f32> {\n    let k = vec2<f32>(\n        dot(p, vec2<f32>(127.1, 311.7)),\n        dot(p, vec2<f32>(269.5, 183.3)),\n    );\n    return fract(sin(k) * 43758.5453) * 2.0 - 1.0;\n}\n\n// Gradient (Perlin) noise with C2-continuous quintic interpolation.\n// Returns [0, 1]. Much less grid-aligned artifact than value noise.\nfn mat_noise(p: vec2<f32>) -> f32 {\n    let i = floor(p);\n    let f = fract(p);\n    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);\n\n    let g00 = dot(mat_hash_grad(i + vec2<f32>(0.0, 0.0)), f - vec2<f32>(0.0, 0.0));\n    let g10 = dot(mat_hash_grad(i + vec2<f32>(1.0, 0.0)), f - vec2<f32>(1.0, 0.0));\n    let g01 = dot(mat_hash_grad(i + vec2<f32>(0.0, 1.0)), f - vec2<f32>(0.0, 1.0));\n    let g11 = dot(mat_hash_grad(i + vec2<f32>(1.0, 1.0)), f - vec2<f32>(1.0, 1.0));\n\n    return mix(mix(g00, g10, u.x), mix(g01, g11, u.x), u.y) * 0.5 + 0.5;\n}\n\n// FBM with inter-octave rotation — breaks grid-aligned artifacts of basic noise\nfn mat_fbm(uv: vec2<f32>, octaves: i32, lacunarity: f32, persistence: f32) -> f32 {\n    var p = uv;\n    var value = 0.0;\n    var amplitude = 0.5;\n    let c = cos(0.77); let sn = sin(0.77);\n    let r = mat2x2<f32>(c, sn, -sn, c);\n    for (var i = 0; i < octaves; i = i + 1) {\n        value = value + mat_noise(p) * amplitude;\n        p = r * p * lacunarity + vec2<f32>(37.1, 17.3);\n        amplitude = amplitude * persistence;\n    }\n    return value;\n}\n\nstruct LandscapeLayerWeights { w: array<f32, 8>, }\n\nfn landscape_layer_weights(world: vec3<f32>) -> LandscapeLayerWeights {\n    let dims = vec2<i32>(textureDimensions(landscape_weights));\n    let size = max(landscape.bounds.zw, vec2<f32>(0.001));\n    let p = (world.xz - landscape.bounds.xy) / size * vec2<f32>(dims) - 0.5;\n    let cell = floor(p);\n    let f = p - cell;\n    let hi = max(dims - vec2<i32>(1), vec2<i32>(0));\n    let i0 = clamp(vec2<i32>(cell), vec2<i32>(0), hi);\n    let i1 = clamp(vec2<i32>(cell) + vec2<i32>(1), vec2<i32>(0), hi);\n    let a = mix(\n        mix(textureLoad(landscape_weights, i0, 0, 0), textureLoad(landscape_weights, vec2<i32>(i1.x, i0.y), 0, 0), f.x),\n        mix(textureLoad(landscape_weights, vec2<i32>(i0.x, i1.y), 0, 0), textureLoad(landscape_weights, i1, 0, 0), f.x),\n        f.y,\n    );\n    let b = mix(\n        mix(textureLoad(landscape_weights, i0, 1, 0), textureLoad(landscape_weights, vec2<i32>(i1.x, i0.y), 1, 0), f.x),\n        mix(textureLoad(landscape_weights, vec2<i32>(i0.x, i1.y), 1, 0), textureLoad(landscape_weights, i1, 1, 0), f.x),\n        f.y,\n    );\n    // Both `var`: indexing by a loop counter needs a reference, not a value.\n    var raw = array<f32, 8>(a.x, a.y, a.z, a.w, b.x, b.y, b.z, b.w);\n    var channels = array<u32, 8>(\n        landscape.channels_a.x, landscape.channels_a.y, landscape.channels_a.z, landscape.channels_a.w,\n        landscape.channels_b.x, landscape.channels_b.y, landscape.channels_b.z, landscape.channels_b.w,\n    );\n    let on = landscape.info.x > 0.5;\n    var out: LandscapeLayerWeights;\n    for (var i = 0u; i < 8u; i = i + 1u) {\n        let painted = raw[min(channels[i], 7u)];\n        out.w[i] = select(select(0.0, 1.0, i == 0u), painted, on);\n    }\n    return out;\n}\n\n@fragment\nfn fragment(\n@if(MESHLET_MESH_MATERIAL_PASS) @builtin(position) frag_coord: vec4<f32>,\n@if(!MESHLET_MESH_MATERIAL_PASS) in: VertexOutput,\n@if(!MESHLET_MESH_MATERIAL_PASS) @builtin(front_facing) is_front: bool,\n) -> FragmentOutput {\n    @if(MESHLET_MESH_